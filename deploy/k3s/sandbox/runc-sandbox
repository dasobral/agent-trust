#!/usr/bin/env python3
# Sandbox only. Some container sandboxes drop CAP_SYS_RESOURCE, so a negative
# oomScoreAdj (Kubernetes gives -998 to pod sandboxes) makes runc fail with
# "failed to update /proc/self/oom_score_adj: Permission denied". This wrapper clamps
# it to 0 and runs the real runc. Install it as Docker's default runtime only on such
# hosts (see deploy/k3s/README.md, "Running k3s inside a container"). Never on a
# normal host.
import json
import os
import sys

args = sys.argv[1:]
for key in ("--bundle", "-b"):
    if key in args:
        path = os.path.join(args[args.index(key) + 1], "config.json")
        try:
            with open(path) as handle:
                config = json.load(handle)
            process = config.get("process", {})
            if process.get("oomScoreAdj", 0) < 0:
                process["oomScoreAdj"] = 0
                with open(path, "w") as handle:
                    json.dump(config, handle)
        except (OSError, ValueError):
            pass
        break
os.execv("/usr/bin/runc", ["runc", *args])
